<?xml version="1.0" encoding="UTF-8"?>
<!--
  LegalRuleML Rules for Criminal Code of Montenegro - Chapter 23
  Crimes Against Payment System and Economic Operations
  For use with DR-Device Rule-Based Reasoning System
  
  Project: Правна Информатика - Team 8
  Purpose: Decision Support System for Judges
-->
<lrml:LegalRuleML xmlns:lrml="http://docs.oasis-open.org/legalruleml/ns/v1.0/"
                   xmlns:ruleml="http://ruleml.org/spec"
                   xmlns:xs="http://www.w3.org/2001/XMLSchema">
  
  <lrml:Metadata>
    <lrml:LegalSource>
      <lrml:LegalSourceInfo>
        <lrml:title>Кривични законик Црне Горе - Глава XXIII</lrml:title>
        <lrml:creator>Скупштина Црне Горе</lrml:creator>
        <lrml:language>sr</lrml:language>
        <lrml:jurisdiction>Montenegro</lrml:jurisdiction>
      </lrml:LegalSourceInfo>
    </lrml:LegalSource>
  </lrml:Metadata>

  <lrml:Statements>
    
    <!-- ========== ARTICLE 258: COUNTERFEITING MONEY ========== -->
    
    <!-- Rule 1: Art. 258 st. 1 - Making counterfeit money -->
    <lrml:ConstitutiveStatement key="rule_258_1">
      <lrml:Rule>
        <lrml:Paraphrase>
          Ко направи лажан новац у намјери да га стави у оптицај као прави или ко у истој намјери преиначи прави новац, казниће се затвором од двије до дванаест година.
        </lrml:Paraphrase>
        <ruleml:if>
          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel>pravi_lazan_novac</ruleml:Rel>
              <ruleml:Var>Okrivljeni</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Or>
              <ruleml:Atom>
                <ruleml:Rel>namjera_stavljanja_u_opticaj</ruleml:Rel>
                <ruleml:Var>Okrivljeni</ruleml:Var>
              </ruleml:Atom>
              <ruleml:Atom>
                <ruleml:Rel>preinacuje_pravi_novac</ruleml:Rel>
                <ruleml:Var>Okrivljeni</ruleml:Var>
              </ruleml:Atom>
            </ruleml:Or>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <ruleml:Atom>
            <ruleml:Rel>kazna_zatvora</ruleml:Rel>
            <ruleml:Var>Okrivljeni</ruleml:Var>
            <ruleml:Data xsi:type="xs:integer" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">2</ruleml:Data>
            <ruleml:Data xsi:type="xs:integer" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">12</ruleml:Data>
          </ruleml:Atom>
        </ruleml:then>
      </lrml:Rule>
      <lrml:LegalReference refersTo="/akn/me/act/criminal-code#art_258__para_1"/>
    </lrml:ConstitutiveStatement>
    
    <!-- Rule 2: Art. 258 st. 2 - Distributing counterfeit money -->
    <lrml:ConstitutiveStatement key="rule_258_2">
      <lrml:Rule>
        <lrml:Paraphrase>
          Ко прибавља, држи или преноси лажан новац у намјери да га стави у оптицај као прави или ко лажан новац ставља у оптицај, казниће се затвором од двије до десет година.
        </lrml:Paraphrase>
        <ruleml:if>
          <ruleml:Or>
            <ruleml:And>
              <ruleml:Atom>
                <ruleml:Rel>pribavlja_lazan_novac</ruleml:Rel>
                <ruleml:Var>Okrivljeni</ruleml:Var>
              </ruleml:Atom>
              <ruleml:Atom>
                <ruleml:Rel>namjera_stavljanja_u_opticaj</ruleml:Rel>
                <ruleml:Var>Okrivljeni</ruleml:Var>
              </ruleml:Atom>
            </ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel>stavlja_lazan_novac_u_opticaj</ruleml:Rel>
              <ruleml:Var>Okrivljeni</ruleml:Var>
            </ruleml:Atom>
          </ruleml:Or>
        </ruleml:if>
        <ruleml:then>
          <ruleml:Atom>
            <ruleml:Rel>kazna_zatvora</ruleml:Rel>
            <ruleml:Var>Okrivljeni</ruleml:Var>
            <ruleml:Data xsi:type="xs:integer" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">2</ruleml:Data>
            <ruleml:Data xsi:type="xs:integer" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">10</ruleml:Data>
          </ruleml:Atom>
        </ruleml:then>
      </lrml:Rule>
      <lrml:LegalReference refersTo="/akn/me/act/criminal-code#art_258__para_2"/>
    </lrml:ConstitutiveStatement>
    
    <!-- Rule 3: Art. 258 st. 3 - Qualified form (amount > 15000 EUR) -->
    <lrml:ConstitutiveStatement key="rule_258_3">
      <lrml:Rule>
        <lrml:Paraphrase>
          Ако је дјелом из ст. 1 и 2 овог члана направљен, преиначен, стављен у промет или прибављен лажан новац у износу који прелази петнаест хиљада еура, учинилац ће се казнити затвором од пет до петнаест година.
        </lrml:Paraphrase>
        <ruleml:if>
          <ruleml:And>
            <ruleml:Or>
              <ruleml:Atom>
                <ruleml:Rel>pravi_lazan_novac</ruleml:Rel>
                <ruleml:Var>Okrivljeni</ruleml:Var>
              </ruleml:Atom>
              <ruleml:Atom>
                <ruleml:Rel>stavlja_lazan_novac_u_opticaj</ruleml:Rel>
                <ruleml:Var>Okrivljeni</ruleml:Var>
              </ruleml:Atom>
            </ruleml:Or>
            <ruleml:Atom>
              <ruleml:Rel>iznos_prelazi</ruleml:Rel>
              <ruleml:Var>Iznos</ruleml:Var>
              <ruleml:Data xsi:type="xs:integer" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">15000</ruleml:Data>
            </ruleml:Atom>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <ruleml:Atom>
            <ruleml:Rel>kazna_zatvora</ruleml:Rel>
            <ruleml:Var>Okrivljeni</ruleml:Var>
            <ruleml:Data xsi:type="xs:integer" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">5</ruleml:Data>
            <ruleml:Data xsi:type="xs:integer" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">15</ruleml:Data>
          </ruleml:Atom>
        </ruleml:then>
      </lrml:Rule>
      <lrml:LegalReference refersTo="/akn/me/act/criminal-code#art_258__para_3"/>
    </lrml:ConstitutiveStatement>
    
    <!-- ========== ARTICLE 260: CREDIT CARD FRAUD ========== -->
    
    <!-- Rule 4: Art. 260 st. 1 - Basic credit card fraud -->
    <lrml:ConstitutiveStatement key="rule_260_1">
      <lrml:Rule>
        <lrml:Paraphrase>
          Ко направи лажну платну картицу или ко преиначи праву платну картицу у намјери да је употријеби као праву, или ко такву лажну платну картицу или туђу праву платну картицу која је неовлашћено прибављена набави, држи или пренесе ради употребе или такву картицу употријеби, казниће се затвором до три године.
        </lrml:Paraphrase>
        <ruleml:if>
          <ruleml:Or>
            <ruleml:Atom>
              <ruleml:Rel>pravi_laznu_karticu</ruleml:Rel>
              <ruleml:Var>Okrivljeni</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel>preinacuje_pravu_karticu</ruleml:Rel>
              <ruleml:Var>Okrivljeni</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel>neovlasceno_pribavlja_karticu</ruleml:Rel>
              <ruleml:Var>Okrivljeni</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel>upotrebljava_laznu_karticu</ruleml:Rel>
              <ruleml:Var>Okrivljeni</ruleml:Var>
            </ruleml:Atom>
          </ruleml:Or>
        </ruleml:if>
        <ruleml:then>
          <ruleml:Atom>
            <ruleml:Rel>kazna_zatvora_do</ruleml:Rel>
            <ruleml:Var>Okrivljeni</ruleml:Var>
            <ruleml:Data xsi:type="xs:integer" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">3</ruleml:Data>
          </ruleml:Atom>
        </ruleml:then>
      </lrml:Rule>
      <lrml:LegalReference refersTo="/akn/me/act/criminal-code#art_260__para_1"/>
    </lrml:ConstitutiveStatement>
    
    <!-- Rule 5: Art. 260 st. 2 - Credit card fraud with gain -->
    <lrml:ConstitutiveStatement key="rule_260_2">
      <lrml:Rule>
        <lrml:Paraphrase>
          Ако је учинилац дјела из става 1 овог члана употребом картице прибавио противправну имовинску корист, казниће се затвором од шест мјесеци до пет година.
        </lrml:Paraphrase>
        <ruleml:if>
          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel>zloupotrebljava_karticu</ruleml:Rel>
              <ruleml:Var>Okrivljeni</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel>pribavio_imovinsku_korist</ruleml:Rel>
              <ruleml:Var>Okrivljeni</ruleml:Var>
              <ruleml:Var>Iznos</ruleml:Var>
            </ruleml:Atom>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <ruleml:Atom>
            <ruleml:Rel>kazna_zatvora</ruleml:Rel>
            <ruleml:Var>Okrivljeni</ruleml:Var>
            <ruleml:Data xsi:type="xs:string" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">6_mjeseci</ruleml:Data>
            <ruleml:Data xsi:type="xs:integer" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">5</ruleml:Data>
          </ruleml:Atom>
        </ruleml:then>
      </lrml:Rule>
      <lrml:LegalReference refersTo="/akn/me/act/criminal-code#art_260__para_2"/>
    </lrml:ConstitutiveStatement>
    
    <!-- Rule 6: Art. 260 st. 3 - Credit card fraud > 3000 EUR -->
    <lrml:ConstitutiveStatement key="rule_260_3">
      <lrml:Rule>
        <lrml:Paraphrase>
          Ако је учинилац дјела из става 1 овог члана прибавио противправну имовинску корист у износу који прелази три хиљаде еура, казниће се затвором од једне до осам година.
        </lrml:Paraphrase>
        <ruleml:if>
          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel>zloupotrebljava_karticu</ruleml:Rel>
              <ruleml:Var>Okrivljeni</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel>pribavio_imovinsku_korist</ruleml:Rel>
              <ruleml:Var>Okrivljeni</ruleml:Var>
              <ruleml:Var>Iznos</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel>iznos_prelazi</ruleml:Rel>
              <ruleml:Var>Iznos</ruleml:Var>
              <ruleml:Data xsi:type="xs:integer" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">3000</ruleml:Data>
            </ruleml:Atom>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <ruleml:Atom>
            <ruleml:Rel>kazna_zatvora</ruleml:Rel>
            <ruleml:Var>Okrivljeni</ruleml:Var>
            <ruleml:Data xsi:type="xs:integer" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">1</ruleml:Data>
            <ruleml:Data xsi:type="xs:integer" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">8</ruleml:Data>
          </ruleml:Atom>
        </ruleml:then>
      </lrml:Rule>
      <lrml:LegalReference refersTo="/akn/me/act/criminal-code#art_260__para_3"/>
    </lrml:ConstitutiveStatement>
    
    <!-- Rule 7: Art. 260 st. 4 - Credit card fraud > 30000 EUR -->
    <lrml:ConstitutiveStatement key="rule_260_4">
      <lrml:Rule>
        <lrml:Paraphrase>
          Ако је учинилац дјела из става 1 овог члана прибавио противправну имовинску корист у износу који прелази тридесет хиљада еура, казниће се затвором од двије до десет година.
        </lrml:Paraphrase>
        <ruleml:if>
          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel>zloupotrebljava_karticu</ruleml:Rel>
              <ruleml:Var>Okrivljeni</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel>pribavio_imovinsku_korist</ruleml:Rel>
              <ruleml:Var>Okrivljeni</ruleml:Var>
              <ruleml:Var>Iznos</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel>iznos_prelazi</ruleml:Rel>
              <ruleml:Var>Iznos</ruleml:Var>
              <ruleml:Data xsi:type="xs:integer" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">30000</ruleml:Data>
            </ruleml:Atom>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <ruleml:Atom>
            <ruleml:Rel>kazna_zatvora</ruleml:Rel>
            <ruleml:Var>Okrivljeni</ruleml:Var>
            <ruleml:Data xsi:type="xs:integer" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">2</ruleml:Data>
            <ruleml:Data xsi:type="xs:integer" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">10</ruleml:Data>
          </ruleml:Atom>
        </ruleml:then>
      </lrml:Rule>
      <lrml:LegalReference refersTo="/akn/me/act/criminal-code#art_260__para_4"/>
    </lrml:ConstitutiveStatement>
    
    <!-- ========== MITIGATING FACTORS RULES ========== -->
    
    <!-- Rule 8: Confession as mitigating factor -->
    <lrml:ConstitutiveStatement key="rule_mitigating_confession">
      <lrml:Rule>
        <lrml:Paraphrase>
          Признање кривице је олакшавајућа околност која може утицати на умањење казне.
        </lrml:Paraphrase>
        <ruleml:if>
          <ruleml:Atom>
            <ruleml:Rel>priznaje_krivicu</ruleml:Rel>
            <ruleml:Var>Okrivljeni</ruleml:Var>
          </ruleml:Atom>
        </ruleml:if>
        <ruleml:then>
          <ruleml:Atom>
            <ruleml:Rel>olaksavajuca_okolnost</ruleml:Rel>
            <ruleml:Var>Okrivljeni</ruleml:Var>
            <ruleml:Data xsi:type="xs:string" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">priznanje</ruleml:Data>
          </ruleml:Atom>
        </ruleml:then>
      </lrml:Rule>
    </lrml:ConstitutiveStatement>
    
    <!-- Rule 9: First offense as mitigating factor -->
    <lrml:ConstitutiveStatement key="rule_mitigating_first_offense">
      <lrml:Rule>
        <lrml:Paraphrase>
          Раније неосуђиваност је олакшавајућа околност.
        </lrml:Paraphrase>
        <ruleml:if>
          <ruleml:Not>
            <ruleml:Atom>
              <ruleml:Rel>ranije_osudivan</ruleml:Rel>
              <ruleml:Var>Okrivljeni</ruleml:Var>
            </ruleml:Atom>
          </ruleml:Not>
        </ruleml:if>
        <ruleml:then>
          <ruleml:Atom>
            <ruleml:Rel>olaksavajuca_okolnost</ruleml:Rel>
            <ruleml:Var>Okrivljeni</ruleml:Var>
            <ruleml:Data xsi:type="xs:string" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">ranije_neosudivan</ruleml:Data>
          </ruleml:Atom>
        </ruleml:then>
      </lrml:Rule>
    </lrml:ConstitutiveStatement>
    
    <!-- Rule 10: Restitution as mitigating factor -->
    <lrml:ConstitutiveStatement key="rule_mitigating_restitution">
      <lrml:Rule>
        <lrml:Paraphrase>
          Накнада штете оштећеном је олакшавајућа околност.
        </lrml:Paraphrase>
        <ruleml:if>
          <ruleml:Atom>
            <ruleml:Rel>nadoknadio_stetu</ruleml:Rel>
            <ruleml:Var>Okrivljeni</ruleml:Var>
          </ruleml:Atom>
        </ruleml:if>
        <ruleml:then>
          <ruleml:Atom>
            <ruleml:Rel>olaksavajuca_okolnost</ruleml:Rel>
            <ruleml:Var>Okrivljeni</ruleml:Var>
            <ruleml:Data xsi:type="xs:string" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">naknada_stete</ruleml:Data>
          </ruleml:Atom>
        </ruleml:then>
      </lrml:Rule>
    </lrml:ConstitutiveStatement>
    
    <!-- ========== AGGRAVATING FACTORS RULES ========== -->
    
    <!-- Rule 11: Prior convictions as aggravating factor -->
    <lrml:ConstitutiveStatement key="rule_aggravating_prior">
      <lrml:Rule>
        <lrml:Paraphrase>
          Раније осуђиваност је отежавајућа околност.
        </lrml:Paraphrase>
        <ruleml:if>
          <ruleml:Atom>
            <ruleml:Rel>ranije_osudivan</ruleml:Rel>
            <ruleml:Var>Okrivljeni</ruleml:Var>
          </ruleml:Atom>
        </ruleml:if>
        <ruleml:then>
          <ruleml:Atom>
            <ruleml:Rel>otezavajuca_okolnost</ruleml:Rel>
            <ruleml:Var>Okrivljeni</ruleml:Var>
            <ruleml:Data xsi:type="xs:string" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">ranije_osudivan</ruleml:Data>
          </ruleml:Atom>
        </ruleml:then>
      </lrml:Rule>
    </lrml:ConstitutiveStatement>
    
    <!-- Rule 12: Organized crime as aggravating factor -->
    <lrml:ConstitutiveStatement key="rule_aggravating_organized">
      <lrml:Rule>
        <lrml:Paraphrase>
          Учешће у организованој криминалној групи је отежавајућа околност.
        </lrml:Paraphrase>
        <ruleml:if>
          <ruleml:Atom>
            <ruleml:Rel>clan_organizovane_grupe</ruleml:Rel>
            <ruleml:Var>Okrivljeni</ruleml:Var>
          </ruleml:Atom>
        </ruleml:if>
        <ruleml:then>
          <ruleml:Atom>
            <ruleml:Rel>otezavajuca_okolnost</ruleml:Rel>
            <ruleml:Var>Okrivljeni</ruleml:Var>
            <ruleml:Data xsi:type="xs:string" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">organizovana_grupa</ruleml:Data>
          </ruleml:Atom>
        </ruleml:then>
      </lrml:Rule>
    </lrml:ConstitutiveStatement>
    
    <!-- ========== SENTENCING RULES ========== -->
    
    <!-- Rule 13: Suspended sentence eligibility -->
    <lrml:ConstitutiveStatement key="rule_suspended_sentence">
      <lrml:Rule>
        <lrml:Paraphrase>
          Условна осуда се може изрећи за казну затвора до двије године уколико постоје олакшавајуће околности.
        </lrml:Paraphrase>
        <ruleml:if>
          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel>kazna_zatvora_do</ruleml:Rel>
              <ruleml:Var>Okrivljeni</ruleml:Var>
              <ruleml:Var>Godine</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel>godine_manje_od</ruleml:Rel>
              <ruleml:Var>Godine</ruleml:Var>
              <ruleml:Data xsi:type="xs:integer" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">2</ruleml:Data>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel>ima_olaksavajuce_okolnosti</ruleml:Rel>
              <ruleml:Var>Okrivljeni</ruleml:Var>
            </ruleml:Atom>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <ruleml:Atom>
            <ruleml:Rel>moguca_uslovna_osuda</ruleml:Rel>
            <ruleml:Var>Okrivljeni</ruleml:Var>
          </ruleml:Atom>
        </ruleml:then>
      </lrml:Rule>
    </lrml:ConstitutiveStatement>
    
    <!-- Rule 14: Sentence reduction with mitigating factors -->
    <lrml:ConstitutiveStatement key="rule_sentence_reduction">
      <lrml:Rule>
        <lrml:Paraphrase>
          Уколико постоје вишеструке олакшавајуће околности, казна се може смањити до законског минимума.
        </lrml:Paraphrase>
        <ruleml:if>
          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel>olaksavajuca_okolnost</ruleml:Rel>
              <ruleml:Var>Okrivljeni</ruleml:Var>
              <ruleml:Var>Faktor1</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel>olaksavajuca_okolnost</ruleml:Rel>
              <ruleml:Var>Okrivljeni</ruleml:Var>
              <ruleml:Var>Faktor2</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel>razliciti</ruleml:Rel>
              <ruleml:Var>Faktor1</ruleml:Var>
              <ruleml:Var>Faktor2</ruleml:Var>
            </ruleml:Atom>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <ruleml:Atom>
            <ruleml:Rel>smanjenje_kazne_dozvoljeno</ruleml:Rel>
            <ruleml:Var>Okrivljeni</ruleml:Var>
          </ruleml:Atom>
        </ruleml:then>
      </lrml:Rule>
    </lrml:ConstitutiveStatement>
    
    <!-- Rule 15: Sentence increase with aggravating factors -->
    <lrml:ConstitutiveStatement key="rule_sentence_increase">
      <lrml:Rule>
        <lrml:Paraphrase>
          Уколико постоје отежавајуће околности, казна се може повећати ка законском максимуму.
        </lrml:Paraphrase>
        <ruleml:if>
          <ruleml:Atom>
            <ruleml:Rel>otezavajuca_okolnost</ruleml:Rel>
            <ruleml:Var>Okrivljeni</ruleml:Var>
            <ruleml:Var>Faktor</ruleml:Var>
          </ruleml:Atom>
        </ruleml:if>
        <ruleml:then>
          <ruleml:Atom>
            <ruleml:Rel>povecanje_kazne_preporuceno</ruleml:Rel>
            <ruleml:Var>Okrivljeni</ruleml:Var>
          </ruleml:Atom>
        </ruleml:then>
      </lrml:Rule>
    </lrml:ConstitutiveStatement>
    
    <!-- ========== CONCURRENCE OF CRIMES (STICAJ) ========== -->
    
    <!-- Rule 16: Concurrence of crimes - unified sentence -->
    <lrml:ConstitutiveStatement key="rule_sticaj">
      <lrml:Rule>
        <lrml:Paraphrase>
          У случају стицаја кривичних дјела, суд изриче јединствену казну која не може бити већа од збира појединачних казни нити од двадесет година затвора.
        </lrml:Paraphrase>
        <ruleml:if>
          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel>kriv_za_djelo</ruleml:Rel>
              <ruleml:Var>Okrivljeni</ruleml:Var>
              <ruleml:Var>Djelo1</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel>kriv_za_djelo</ruleml:Rel>
              <ruleml:Var>Okrivljeni</ruleml:Var>
              <ruleml:Var>Djelo2</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel>razliciti</ruleml:Rel>
              <ruleml:Var>Djelo1</ruleml:Var>
              <ruleml:Var>Djelo2</ruleml:Var>
            </ruleml:Atom>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <ruleml:Atom>
            <ruleml:Rel>izrice_se_jedinstvena_kazna</ruleml:Rel>
            <ruleml:Var>Okrivljeni</ruleml:Var>
          </ruleml:Atom>
        </ruleml:then>
      </lrml:Rule>
    </lrml:ConstitutiveStatement>
    
    <!-- ========== CONFISCATION RULES ========== -->
    
    <!-- Rule 17: Confiscation of counterfeit money -->
    <lrml:ConstitutiveStatement key="rule_confiscation_258">
      <lrml:Rule>
        <lrml:Paraphrase>
          Лажан новац одузеће се. (члан 258 ст. 5)
        </lrml:Paraphrase>
        <ruleml:if>
          <ruleml:Atom>
            <ruleml:Rel>predmet_djela_lazan_novac</ruleml:Rel>
            <ruleml:Var>Novac</ruleml:Var>
          </ruleml:Atom>
        </ruleml:if>
        <ruleml:then>
          <ruleml:Atom>
            <ruleml:Rel>oduzima_se</ruleml:Rel>
            <ruleml:Var>Novac</ruleml:Var>
          </ruleml:Atom>
        </ruleml:then>
      </lrml:Rule>
      <lrml:LegalReference refersTo="/akn/me/act/criminal-code#art_258__para_5"/>
    </lrml:ConstitutiveStatement>
    
    <!-- ========== ARTICLE 268: MONEY LAUNDERING ========== -->
    
    <!-- Rule 18: Art. 268 st. 1 - Basic money laundering -->
    <lrml:ConstitutiveStatement key="rule_268_1">
      <lrml:Rule>
        <lrml:Paraphrase>
          Ко изврши конверзију или пренос новца или друге имовине са знањем да су прибављени криминалном дјелатношћу, у намјери да се прикрије поријекло, казниће се затвором од шест мјесеци до пет година.
        </lrml:Paraphrase>
        <ruleml:if>
          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel>konvertuje_ili_prenosi_imovinu</ruleml:Rel>
              <ruleml:Var>Okrivljeni</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel>zna_kriminalno_porijeklo</ruleml:Rel>
              <ruleml:Var>Okrivljeni</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel>namjera_prikrivanja_porijekla</ruleml:Rel>
              <ruleml:Var>Okrivljeni</ruleml:Var>
            </ruleml:Atom>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <ruleml:Atom>
            <ruleml:Rel>kazna_zatvora</ruleml:Rel>
            <ruleml:Var>Okrivljeni</ruleml:Var>
            <ruleml:Data xsi:type="xs:string" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">6_mjeseci</ruleml:Data>
            <ruleml:Data xsi:type="xs:integer" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">5</ruleml:Data>
          </ruleml:Atom>
        </ruleml:then>
      </lrml:Rule>
      <lrml:LegalReference refersTo="/akn/me/act/criminal-code#art_268__para_1"/>
    </lrml:ConstitutiveStatement>
    
    <!-- Rule 19: Art. 268 st. 3 - Qualified money laundering > 40000 EUR -->
    <lrml:ConstitutiveStatement key="rule_268_3">
      <lrml:Rule>
        <lrml:Paraphrase>
          Ако износ новца или вриједност имовине прелазе четрдесет хиљада еура, учинилац ће се казнити затвором од једне до десет година.
        </lrml:Paraphrase>
        <ruleml:if>
          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel>pranje_novca</ruleml:Rel>
              <ruleml:Var>Okrivljeni</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel>iznos_prelazi</ruleml:Rel>
              <ruleml:Var>Iznos</ruleml:Var>
              <ruleml:Data xsi:type="xs:integer" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">40000</ruleml:Data>
            </ruleml:Atom>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <ruleml:Atom>
            <ruleml:Rel>kazna_zatvora</ruleml:Rel>
            <ruleml:Var>Okrivljeni</ruleml:Var>
            <ruleml:Data xsi:type="xs:integer" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">1</ruleml:Data>
            <ruleml:Data xsi:type="xs:integer" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">10</ruleml:Data>
          </ruleml:Atom>
        </ruleml:then>
      </lrml:Rule>
      <lrml:LegalReference refersTo="/akn/me/act/criminal-code#art_268__para_3"/>
    </lrml:ConstitutiveStatement>
    
    <!-- Rule 20: Cooperation with investigation as mitigating -->
    <lrml:ConstitutiveStatement key="rule_mitigating_cooperation">
      <lrml:Rule>
        <lrml:Paraphrase>
          Сарадња са истражним органима је олакшавајућа околност.
        </lrml:Paraphrase>
        <ruleml:if>
          <ruleml:Atom>
            <ruleml:Rel>saradjuje_sa_istragom</ruleml:Rel>
            <ruleml:Var>Okrivljeni</ruleml:Var>
          </ruleml:Atom>
        </ruleml:if>
        <ruleml:then>
          <ruleml:Atom>
            <ruleml:Rel>olaksavajuca_okolnost</ruleml:Rel>
            <ruleml:Var>Okrivljeni</ruleml:Var>
            <ruleml:Data xsi:type="xs:string" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">saradnja_sa_istragom</ruleml:Data>
          </ruleml:Atom>
        </ruleml:then>
      </lrml:Rule>
    </lrml:ConstitutiveStatement>

    <!-- ========== SENTENCING MITIGATION RULES (čl. 42, 45, 46, 47 KZ CG) ========== -->

    <!-- Rule 21: General sentencing - čl. 42 KZ CG -->
    <lrml:ConstitutiveStatement key="rule_odmjeravanje_cl42">
      <lrml:Rule>
        <lrml:Paraphrase>
          Суд ће учиниоцу кривичног дјела одмјерити казну у границама које су законом прописане за то дјело, имајући у виду сврху кажњавања и узимајући у обзир све олакшавајуће и отежавајуће околности (чл. 42 КЗ ЦГ).
        </lrml:Paraphrase>
        <ruleml:if>
          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel>kazna_zatvora</ruleml:Rel>
              <ruleml:Var>Okrivljeni</ruleml:Var>
              <ruleml:Var>MinKazna</ruleml:Var>
              <ruleml:Var>MaxKazna</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel>olaksavajuca_okolnost</ruleml:Rel>
              <ruleml:Var>Okrivljeni</ruleml:Var>
              <ruleml:Var>Okolnost</ruleml:Var>
            </ruleml:Atom>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <ruleml:Atom>
            <ruleml:Rel>kazna_blize_minimumu</ruleml:Rel>
            <ruleml:Var>Okrivljeni</ruleml:Var>
          </ruleml:Atom>
        </ruleml:then>
      </lrml:Rule>
      <lrml:LegalReference refersTo="/akn/me/act/criminal-code#art_42"/>
    </lrml:ConstitutiveStatement>

    <!-- Rule 22: Sentence mitigation eligibility - čl. 45 KZ CG -->
    <lrml:ConstitutiveStatement key="rule_ublazavanje_cl45">
      <lrml:Rule>
        <lrml:Paraphrase>
          Суд може учиниоцу кривичног дјела изрећи казну испод границе прописане законом кад утврди да постоје нарочито олакшавајуће околности и оцијени да се и са ублаженом казном може постићи сврха кажњавања (чл. 45 ст. 3 КЗ ЦГ).
        </lrml:Paraphrase>
        <ruleml:if>
          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel>olaksavajuca_okolnost</ruleml:Rel>
              <ruleml:Var>Okrivljeni</ruleml:Var>
              <ruleml:Var>Faktor1</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel>olaksavajuca_okolnost</ruleml:Rel>
              <ruleml:Var>Okrivljeni</ruleml:Var>
              <ruleml:Var>Faktor2</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel>razliciti</ruleml:Rel>
              <ruleml:Var>Faktor1</ruleml:Var>
              <ruleml:Var>Faktor2</ruleml:Var>
            </ruleml:Atom>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <ruleml:Atom>
            <ruleml:Rel>ublazavanje_dozvoljeno</ruleml:Rel>
            <ruleml:Var>Okrivljeni</ruleml:Var>
          </ruleml:Atom>
        </ruleml:then>
      </lrml:Rule>
      <lrml:LegalReference refersTo="/akn/me/act/criminal-code#art_45"/>
    </lrml:ConstitutiveStatement>

    <!-- Rule 23: Mitigation limits for min 5+ years - čl. 46 st. 1 tač. 1 -->
    <lrml:ConstitutiveStatement key="rule_ublazavanje_cl46_tac1">
      <lrml:Rule>
        <lrml:Paraphrase>
          Ако је за кривично дјело као најмања мјера казне прописан затвор од пет или више година, казна се може ублажити до двије године затвора (чл. 46 ст. 1 тач. 1 КЗ ЦГ).
        </lrml:Paraphrase>
        <ruleml:if>
          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel>ublazavanje_dozvoljeno</ruleml:Rel>
              <ruleml:Var>Okrivljeni</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel>kazna_zatvora_min_godina</ruleml:Rel>
              <ruleml:Var>Okrivljeni</ruleml:Var>
              <ruleml:Data xsi:type="xs:integer" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">5</ruleml:Data>
            </ruleml:Atom>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <ruleml:Atom>
            <ruleml:Rel>ublazena_kazna_min</ruleml:Rel>
            <ruleml:Var>Okrivljeni</ruleml:Var>
            <ruleml:Data xsi:type="xs:integer" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">2</ruleml:Data>
          </ruleml:Atom>
        </ruleml:then>
      </lrml:Rule>
      <lrml:LegalReference refersTo="/akn/me/act/criminal-code#art_46__para_1__point_1"/>
    </lrml:ConstitutiveStatement>

    <!-- Rule 24: Mitigation limits for min 3+ years - čl. 46 st. 1 tač. 2 -->
    <lrml:ConstitutiveStatement key="rule_ublazavanje_cl46_tac2">
      <lrml:Rule>
        <lrml:Paraphrase>
          Ако је за кривично дјело као најмања мјера казне прописан затвор од три или више година, казна се може ублажити до једне године затвора (чл. 46 ст. 1 тач. 2 КЗ ЦГ).
        </lrml:Paraphrase>
        <ruleml:if>
          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel>ublazavanje_dozvoljeno</ruleml:Rel>
              <ruleml:Var>Okrivljeni</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel>kazna_zatvora_min_godina</ruleml:Rel>
              <ruleml:Var>Okrivljeni</ruleml:Var>
              <ruleml:Data xsi:type="xs:integer" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">3</ruleml:Data>
            </ruleml:Atom>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <ruleml:Atom>
            <ruleml:Rel>ublazena_kazna_min</ruleml:Rel>
            <ruleml:Var>Okrivljeni</ruleml:Var>
            <ruleml:Data xsi:type="xs:integer" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">1</ruleml:Data>
          </ruleml:Atom>
        </ruleml:then>
      </lrml:Rule>
      <lrml:LegalReference refersTo="/akn/me/act/criminal-code#art_46__para_1__point_2"/>
    </lrml:ConstitutiveStatement>

    <!-- Rule 25: Mitigation limits for min 2 years - čl. 46 st. 1 tač. 3 -->
    <lrml:ConstitutiveStatement key="rule_ublazavanje_cl46_tac3">
      <lrml:Rule>
        <lrml:Paraphrase>
          Ако је за кривично дјело као најмања мјера казне прописан затвор од двије године, казна се може ублажити до шест мјесеци затвора (чл. 46 ст. 1 тач. 3 КЗ ЦГ).
        </lrml:Paraphrase>
        <ruleml:if>
          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel>ublazavanje_dozvoljeno</ruleml:Rel>
              <ruleml:Var>Okrivljeni</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel>kazna_zatvora_min_godina</ruleml:Rel>
              <ruleml:Var>Okrivljeni</ruleml:Var>
              <ruleml:Data xsi:type="xs:integer" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">2</ruleml:Data>
            </ruleml:Atom>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <ruleml:Atom>
            <ruleml:Rel>ublazena_kazna_min</ruleml:Rel>
            <ruleml:Var>Okrivljeni</ruleml:Var>
            <ruleml:Data xsi:type="xs:string" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">6_mjeseci</ruleml:Data>
          </ruleml:Atom>
        </ruleml:then>
      </lrml:Rule>
      <lrml:LegalReference refersTo="/akn/me/act/criminal-code#art_46__para_1__point_3"/>
    </lrml:ConstitutiveStatement>

    <!-- Rule 26: Mitigation limits for min 1 year - čl. 46 st. 1 tač. 4 -->
    <lrml:ConstitutiveStatement key="rule_ublazavanje_cl46_tac4">
      <lrml:Rule>
        <lrml:Paraphrase>
          Ако је за кривично дјело као најмања мјера казне прописан затвор од једне године, казна се може ублажити до три мјесеца затвора (чл. 46 ст. 1 тач. 4 КЗ ЦГ).
        </lrml:Paraphrase>
        <ruleml:if>
          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel>ublazavanje_dozvoljeno</ruleml:Rel>
              <ruleml:Var>Okrivljeni</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel>kazna_zatvora_min_godina</ruleml:Rel>
              <ruleml:Var>Okrivljeni</ruleml:Var>
              <ruleml:Data xsi:type="xs:integer" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">1</ruleml:Data>
            </ruleml:Atom>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <ruleml:Atom>
            <ruleml:Rel>ublazena_kazna_min</ruleml:Rel>
            <ruleml:Var>Okrivljeni</ruleml:Var>
            <ruleml:Data xsi:type="xs:string" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">3_mjeseca</ruleml:Data>
          </ruleml:Atom>
        </ruleml:then>
      </lrml:Rule>
      <lrml:LegalReference refersTo="/akn/me/act/criminal-code#art_46__para_1__point_4"/>
    </lrml:ConstitutiveStatement>

    <!-- Rule 27: Release from punishment for damage reparation - čl. 47 st. 3 -->
    <lrml:ConstitutiveStatement key="rule_oslobodjenje_cl47">
      <lrml:Rule>
        <lrml:Paraphrase>
          Суд може ослободити од казне учиниоца кривичног дјела за које је прописана казна затвора до пет година, ако послије извршеног кривичног дјела отклони посљедице дјела или надокнади штету проузроковану кривичним дјелом (чл. 47 ст. 3 КЗ ЦГ).
        </lrml:Paraphrase>
        <ruleml:if>
          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel>nadoknadio_stetu</ruleml:Rel>
              <ruleml:Var>Okrivljeni</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel>kazna_zatvora</ruleml:Rel>
              <ruleml:Var>Okrivljeni</ruleml:Var>
              <ruleml:Var>Min</ruleml:Var>
              <ruleml:Var>Max</ruleml:Var>
            </ruleml:Atom>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <ruleml:Atom>
            <ruleml:Rel>oslobodjenje_od_kazne_moguce</ruleml:Rel>
            <ruleml:Var>Okrivljeni</ruleml:Var>
          </ruleml:Atom>
        </ruleml:then>
      </lrml:Rule>
      <lrml:LegalReference refersTo="/akn/me/act/criminal-code#art_47__para_3"/>
    </lrml:ConstitutiveStatement>

    <!-- Rule 28: Suspended sentence - čl. 52-54 KZ CG -->
    <lrml:ConstitutiveStatement key="rule_uslovna_osuda_cl52">
      <lrml:Rule>
        <lrml:Paraphrase>
          Условном осудом суд утврђује казну и истовремено одређује да се она неће извршити ако осуђени за вријеме које одреди суд не учини ново кривично дјело. Може се изрећи кад суд утврди казну затвора у трајању до двије године (чл. 52 КЗ ЦГ).
        </lrml:Paraphrase>
        <ruleml:if>
          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel>utvrdjena_kazna_mjeseci</ruleml:Rel>
              <ruleml:Var>Okrivljeni</ruleml:Var>
              <ruleml:Var>Mjeseci</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel>mjeseci_manje_od</ruleml:Rel>
              <ruleml:Var>Mjeseci</ruleml:Var>
              <ruleml:Data xsi:type="xs:integer" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">24</ruleml:Data>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel>ima_olaksavajuce_okolnosti</ruleml:Rel>
              <ruleml:Var>Okrivljeni</ruleml:Var>
            </ruleml:Atom>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <ruleml:Atom>
            <ruleml:Rel>moguca_uslovna_osuda</ruleml:Rel>
            <ruleml:Var>Okrivljeni</ruleml:Var>
          </ruleml:Atom>
        </ruleml:then>
      </lrml:Rule>
      <lrml:LegalReference refersTo="/akn/me/act/criminal-code#art_52"/>
    </lrml:ConstitutiveStatement>

    <!-- Rule 29: Remorse as mitigating factor -->
    <lrml:ConstitutiveStatement key="rule_mitigating_remorse">
      <lrml:Rule>
        <lrml:Paraphrase>
          Изражено кајање окривљеног је олакшавајућа околност.
        </lrml:Paraphrase>
        <ruleml:if>
          <ruleml:Atom>
            <ruleml:Rel>izrazeno_kajanje</ruleml:Rel>
            <ruleml:Var>Okrivljeni</ruleml:Var>
          </ruleml:Atom>
        </ruleml:if>
        <ruleml:then>
          <ruleml:Atom>
            <ruleml:Rel>olaksavajuca_okolnost</ruleml:Rel>
            <ruleml:Var>Okrivljeni</ruleml:Var>
            <ruleml:Data xsi:type="xs:string" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">kajanje</ruleml:Data>
          </ruleml:Atom>
        </ruleml:then>
      </lrml:Rule>
    </lrml:ConstitutiveStatement>

    <!-- Rule 30: Family circumstances as mitigating factor -->
    <lrml:ConstitutiveStatement key="rule_mitigating_family">
      <lrml:Rule>
        <lrml:Paraphrase>
          Породичне прилике (отац/мајка дјеце) су олакшавајућа околност коју суд узима у обзир при одмјеравању казне.
        </lrml:Paraphrase>
        <ruleml:if>
          <ruleml:Atom>
            <ruleml:Rel>ima_djecu</ruleml:Rel>
            <ruleml:Var>Okrivljeni</ruleml:Var>
          </ruleml:Atom>
        </ruleml:if>
        <ruleml:then>
          <ruleml:Atom>
            <ruleml:Rel>olaksavajuca_okolnost</ruleml:Rel>
            <ruleml:Var>Okrivljeni</ruleml:Var>
