          <b>Sudija:</b>
           Larisa Mijušković
        </p>
        <p>
          <b>Zapisničar:</b>
           Zapisničar
        </p>
        <blockContainer eId="defendant_info">
          <heading>Podaci o okrivljenom</heading>
